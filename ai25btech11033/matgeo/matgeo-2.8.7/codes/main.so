theta_deg = math.degrees(theta_rad)

print("Python Program Output:")
print(f"cos(theta) = {cos_theta:.2f}")
print(f"theta (radians) = {theta_rad:.4f}")
print(f"theta (degrees) = {theta_deg:.2f}")
*/
